{
	"name": "metaedit",
	"version": "1.10.3",
	"description": "MetaEdit helps you manage your metadata.",
	"main": "main.js",
	"repository": {
		"type": "git",
		"url": "https://github.com/chhoumann/MetaEdit.git"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "pnpm run typecheck && node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit -p tsconfig.src.json && svelte-check --tsconfig ./tsconfig.src.json --threshold error",
		"lint": "eslint . --max-warnings=0",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "pnpm run build && vitest run --config vitest.e2e.config.mts",
		"obsidian:e2e": "obsidian-e2e run",
		"provision:e2e-vault": "obsidian-e2e provision",
		"start:e2e-obsidian": "obsidian-e2e start",
		"stop:e2e-obsidian": "obsidian-e2e stop"
	},
	"keywords": [],
	"author": "Christian B. B. Houmann",
	"license": "MIT",
	"packageManager": "pnpm@10.32.1",
	"engines": {
		"node": ">=20.18.1"
	},
	"devDependencies": {
		"@types/node": "26.4.1",
		"@vitest/coverage-v8": "4.1.11",
		"esbuild": "0.28.2",
		"esbuild-svelte": "0.9.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"obsidian": "1.13.1",
		"obsidian-e2e": "^0.10.0",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"svelte-eslint-parser": "^1.8.1",
		"svelte-preprocess": "^6.0.5",
		"tslib": "^2.2.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.69.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"svelte-preprocess"
		],
		"overrides": {
			"@babel/core@<=7.29.0": "^7.29.6",
			"brace-expansion@<1.1.18": "^1.1.18",
			"brace-expansion@>=2.0.0 <2.1.4": "^2.1.4",
			"fast-uri@>=3.0.0 <3.1.5": "^3.1.5",
			"handlebars": "^4.7.9",
			"js-yaml@>=4.0.0 <4.3.1": "^4.3.1",
			"nanoid@<3.3.17": "^3.3.17",
			"postcss@<8.5.23": "^8.5.23"
		}
	}
}
